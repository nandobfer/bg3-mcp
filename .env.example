# Altere para a porta que sera publicada pelo servidor MCP.
BG3_MCP_PORT=3000

# Substitua CHANGE_ME por um email ou URL de contato antes de usar em producao.
BG3_MCP_USER_AGENT="BG3MCP/0.1 (contact: CHANGE_ME)"

BG3_MCP_HOST=0.0.0.0
BG3_MCP_TRANSPORT=streamable-http
BG3_MCP_LOG=info

BG3_WIKI_BASE_URL=https://bg3.wiki
BG3_MCP_HTTP_TIMEOUT_SECS=15
BG3_MCP_MAX_CONCURRENCY=4
BG3_MCP_CACHE_TTL_SECS=300

# O provedor de mods ainda nao foi definido. Descomente quando aplicavel.
# BG3_MODS_BASE_URL=CHANGE_ME
# BG3_MODS_API_KEY=CHANGE_ME
